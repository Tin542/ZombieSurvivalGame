[node name="Run" type="Node2D"]
script = ExtResource("1_run")
weapon_catalog = Array[ExtResource("12_wdef")]([ExtResource("13_pistol"), ExtResource("14_smg"), ExtResource("15_shotgun")])
debug_unlock_all_weapons = true
debug_zombie_pool = Array[ExtResource("7_zdef")]([ExtResource("8_walker"), ExtResource("8_walker"), ExtResource("9_runner"), ExtResource("10_brute")])

[node name="Arena" type="Node2D" parent="."]
script = ExtResource("2_arena")

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Zombies" type="Node2D" parent="World"]
